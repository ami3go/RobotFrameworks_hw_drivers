{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rfds017.schema.json",
  "title": "RFDS-017 AI Driver Contract v3.0 project schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rfds017_version",
    "identity",
    "mental_model",
    "state_machine",
    "resources",
    "dependencies",
    "capabilities",
    "errors",
    "safety",
    "verification_objectives",
    "setup_teardown",
    "planning_hints",
    "limitations",
    "unknown_handling",
    "conformance",
    "open_questions"
  ],
  "$defs": {
    "risk": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH", "DESTRUCTIVE"]},
    "blocking": {"enum": ["BLOCKING", "NON_BLOCKING", "ASYNC_WITH_POLL"]},
    "idempotency": {"enum": ["IDEMPOTENT", "NON_IDEMPOTENT", "CONDITIONALLY_IDEMPOTENT"]},
    "persistence": {"enum": ["VOLATILE", "PERSISTS_UNTIL_RESET", "PERSISTS_ACROSS_POWER_CYCLE"]},
    "retry": {"enum": ["SAFE_TO_RETRY", "RETRY_AFTER_RESET", "NEVER_RETRY"]},
    "errorClass": {"enum": ["TRANSIENT", "CONFIGURATION", "HARDWARE_FAULT", "SAFETY_TRIP", "COMMUNICATION", "STATE_VIOLATION"]},
    "postErrorState": {"enum": ["STATE_UNCHANGED", "STATE_UNDEFINED", "SAFE_STATE", "REQUIRES_REINIT"]},
    "paramKind": {"enum": ["NUMERIC", "ENUM", "BOOLEAN", "STRING", "DURATION"]},
    "resourceAccess": {"enum": ["EXCLUSIVE", "SHARED_READ", "SHARED_WRITE"]},
    "oracleType": {"enum": ["TOLERANCE_ABS", "TOLERANCE_REL", "EXACT_MATCH", "RANGE", "STATE_QUERY", "EXTERNAL_REFERENCE"]},
    "argument": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "kind", "required", "default"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/paramKind"},
        "required": {"type": "boolean"},
        "default": {},
        "unit": {"type": "string"},
        "range": {"type": "array", "minItems": 2, "maxItems": 2},
        "values": {"type": "array", "minItems": 1}
      }
    },
    "return": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/paramKind"},
        "unit": {"type": "string"},
        "format": {"type": "string"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyword", "signature", "purpose", "risk_level", "blocking", "idempotency", "retry",
        "typical_execution_time_s", "stabilization_time_s", "valid_in_states", "resulting_state",
        "arguments", "returns", "preconditions", "postconditions", "coupling", "side_effects",
        "exclusive_resources", "raises", "planning_priority"
      ],
      "properties": {
        "keyword": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 3},
        "purpose": {"type": "string", "minLength": 3},
        "risk_level": {"$ref": "#/$defs/risk"},
        "blocking": {"$ref": "#/$defs/blocking"},
        "idempotency": {"$ref": "#/$defs/idempotency"},
        "retry": {"$ref": "#/$defs/retry"},
        "typical_execution_time_s": {"type": "number", "minimum": 0},
        "stabilization_time_s": {"type": "number", "minimum": 0},
        "valid_in_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "resulting_state": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"$ref": "#/$defs/argument"}},
        "returns": {"type": "array", "items": {"$ref": "#/$defs/return"}},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "postconditions": {"type": "array", "items": {"type": "string"}},
        "coupling": {"type": "array", "items": {"type": "string", "pattern": "^(REQUIRES|FORBIDS|ORDER|MUTEX):"}},
        "side_effects": {"type": "array", "items": {"type": "string"}},
        "exclusive_resources": {"type": "array", "items": {"type": "string"}},
        "raises": {"type": "array", "items": {"type": "string"}},
        "planning_priority": {"enum": ["PRIMARY", "SECONDARY", "DEBUG_ONLY", "CALIBRATION_ONLY", "FACTORY_ONLY"]}
      }
    }
  },
  "properties": {
    "rfds017_version": {"const": "3.0"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver_name", "driver_version", "contract_version", "supported_models", "instrument_class", "primary_role"],
      "properties": {
        "driver_name": {"type": "string", "minLength": 1},
        "driver_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "supported_models": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "instrument_class": {"type": "string", "minLength": 1},
        "primary_role": {"type": "string", "minLength": 3}
      }
    },
    "mental_model": {
      "type": "object",
      "additionalProperties": true,
      "required": ["physical_object", "configuration_persistence", "concurrency", "ownership", "blocking_behavior"],
      "properties": {
        "physical_object": {"type": "string"},
        "configuration_persistence": {"$ref": "#/$defs/persistence"},
        "concurrency": {
          "type": "object",
          "required": ["max_parallel_sessions", "thread_safe"],
          "properties": {
            "max_parallel_sessions": {"anyOf": [{"type": "integer", "minimum": 1}, {"const": "UNKNOWN"}]},
            "thread_safe": {"anyOf": [{"type": "boolean"}, {"const": "UNKNOWN"}]}
          }
        },
        "ownership": {"type": "string"},
        "blocking_behavior": {"type": "string"}
      }
    },
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "initial_state", "transitions"],
      "properties": {
        "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "initial_state": {"type": "string"},
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "via_capability"],
            "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "via_capability": {"type": "string"}}
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumes", "provides", "physical_signals"],
      "properties": {
        "consumes": {
          "type": "array",
          "items": {"type": "object", "required": ["name", "access", "description"], "properties": {"name": {"type": "string"}, "access": {"$ref": "#/$defs/resourceAccess"}, "description": {"type": "string"}}}
        },
        "provides": {"type": "array", "items": {"type": "object", "required": ["name", "description"]}},
        "physical_signals": {"type": "object", "required": ["inputs", "outputs"]}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_before", "enables_after", "conflicts_with"],
      "properties": {
        "requires_before": {"type": "array", "items": {"type": "string"}},
        "enables_after": {"type": "array", "items": {"type": "string"}},
        "conflicts_with": {"type": "array", "items": {"type": "string"}}
      }
    },
    "connection_points": {"type": "object"},
    "measurement_quality": {"type": "object"},
    "implementation_status": {"type": "object"},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "class", "meaning", "detection", "post_error_state", "retry", "recovery"],
        "properties": {
          "name": {"type": "string"},
          "class": {"$ref": "#/$defs/errorClass"},
          "meaning": {"type": "string"},
          "detection": {"type": "string"},
          "post_error_state": {"$ref": "#/$defs/postErrorState"},
          "retry": {"$ref": "#/$defs/retry"},
          "recovery": {"type": "string"}
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": ["dangerous_operations", "forbidden_sequences", "required_delays", "hardware_limits", "safe_shutdown_sequence"],
      "properties": {
        "dangerous_operations": {"type": "array"},
        "forbidden_sequences": {"type": "array"},
        "required_delays": {"type": "array"},
        "hardware_limits": {"type": "array"},
        "safe_shutdown_sequence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "verification_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "goal", "procedure", "oracle", "requires_drivers", "risk_level"],
        "properties": {
          "id": {"type": "string"},
          "goal": {"type": "string"},
          "procedure": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "oracle": {"type": "object", "required": ["type", "measured_by"], "properties": {"type": {"$ref": "#/$defs/oracleType"}, "measured_by": {"type": "string"}}},
          "requires_drivers": {"type": "array", "items": {"type": "string"}},
          "risk_level": {"$ref": "#/$defs/risk"}
        }
      }
    },
    "test_templates": {"type": "array"},
    "setup_teardown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_setup", "suite_teardown", "teardown_safe_from_any_state"],
      "properties": {
        "suite_setup": {"type": "array", "items": {"type": "string"}},
        "suite_teardown": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "teardown_safe_from_any_state": {"type": "boolean"}
      }
    },
    "planning_hints": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "unknown_handling": {"type": "object"},
    "conformance": {"type": "object"},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
