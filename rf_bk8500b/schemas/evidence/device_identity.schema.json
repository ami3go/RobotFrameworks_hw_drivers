{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rfds.local/schemas/rf_bk8500b/device_identity.schema.json",
  "title": "rfds.device_identity",
  "description": "device_identity.json — recorded, when available, for a connected B&K Precision 8500B-series electronic load.",
  "type": "object",
  "required": ["schema", "schema_version", "run_id", "timestamp_utc"],
  "properties": {
    "schema": {"const": "rfds.device_identity"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "run_id": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "manufacturer": {"type": "string"},
    "model": {"type": "string"},
    "serial_number": {"type": ["string", "null"]},
    "firmware_version": {"type": ["string", "null"]},
    "port": {"type": "string"},
    "protocol": {"enum": ["scpi", "legacy", "auto"]},
    "alias": {"type": "string"}
  },
  "additionalProperties": true
}
