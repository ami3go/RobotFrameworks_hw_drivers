{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rfds.local/schemas/rf_slcan/device_identity.schema.json",
  "title": "rfds.device_identity",
  "description": "device_identity.json — recorded after a successful SLCAN identify() (V/N queries).",
  "type": "object",
  "required": ["schema", "schema_version", "run_id", "timestamp_utc"],
  "properties": {
    "schema": {"const": "rfds.device_identity"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "run_id": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "manufacturer": {"type": "string"},
    "hardware_version": {"type": "string"},
    "software_version": {"type": "string"},
    "serial_number": {"type": "string"},
    "resource": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
